<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="CodeKamikaze Demo Website">
    <title>CodeKamikaze</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            font-family:Segoe UI, Tahoma, Geneva, Verdana, sans-serif;
            background:#f5f5f5;
            color:#333;
            line-height:1.6;
        }

        .container{
            max-width:1200px;
            margin:20px auto;
            padding:0 15px;
        }

        .hero{
            background:#0d6efd;
            color:#fff;
            padding:40px;
            border-radius:8px;
            margin-bottom:20px;
            box-shadow:0 2px 6px rgba(0,0,0,.15);
        }

        .hero h1{
            font-size:42px;
            margin-bottom:10px;
        }

        .card{
            background:#fff;
            padding:30px;
            border-radius:8px;
            margin-bottom:20px;
            box-shadow:0 2px 4px rgba(0,0,0,.08);
        }

        .card h2{
            margin-bottom:15px;
            color:#222;
        }

        .card p{
            margin-bottom:15px;
        }

        .card ul{
            margin-left:25px;
            margin-bottom:20px;
        }

        .card li{
            margin-bottom:8px;
        }

        .btn{
            background:#0d6efd;
            color:#fff;
            border:none;
            padding:10px 20px;
            border-radius:5px;
            cursor:pointer;
            transition:.3s;
        }

        .btn:hover{
            opacity:.9;
        }

        a{
            color:#0d6efd;
            text-decoration:none;
        }

        a:hover{
            text-decoration:underline;
        }

        footer{
            text-align:center;
            padding:20px;
            color:#666;
        }

        @media(max-width:768px){
            .hero h1{
                font-size:28px;
            }

            .card{
                padding:20px;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <header class="hero">
        <h1>Welcome to CodeKamikaze</h1>
        <p>Simple HTML, CSS and JavaScript Demo Website</p>
    </header>

    <main>

        <section class="card">
            <h2>About This Page</h2>

            <p>
                This page demonstrates basic HTML structure, CSS styling and JavaScript interaction.
            </p>

            <ul>
                <li>Responsive Layout</li>
                <li>Modern Card Design</li>
                <li>JavaScript Alert Button</li>
                <li>GitHub Pages Compatible</li>
            </ul>

            <button class="btn" onclick="showAlert()">
                Click Me
            </button>
        </section>

        <section class="card">
            <h2>Contact</h2>

            <p>
                Visit our sample website:
            </p>

            <a href="https://example.com" target="_blank">
                https://example.com
            </a>
        </section>

    </main>

    <footer>
        © 2025 CodeKamikaze. All Rights Reserved.
    </footer>

</div>

<script>
function showAlert() {
    alert("Hello from CodeKamikaze!");
}
</script>

</body>
</html>
